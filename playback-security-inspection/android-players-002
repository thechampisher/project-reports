        favoriteButton.setAllCaps(false);
        favoriteButton.setPadding(0, 0, 0, dp(3));
        GradientDrawable favoriteBackground = new GradientDrawable();
        favoriteBackground.setColor(0xCC171717);
        favoriteBackground.setCornerRadius(dp(26));
        favoriteButton.setBackground(favoriteBackground);
        favoriteButton.setContentDescription("İSAFLIX favorilere ekle");
        favoriteButton.setOnClickListener(v -> toggleCurrentFavorite());

        Configuration config = getResources().getConfiguration();
        boolean wideDevice = config.orientation == Configuration.ORIENTATION_LANDSCAPE
                && (config.smallestScreenWidthDp >= 600
                || (config.uiMode & Configuration.UI_MODE_TYPE_MASK)
                == Configuration.UI_MODE_TYPE_TELEVISION);
