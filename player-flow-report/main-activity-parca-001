        // ISAFLIX_QUEUE_V2
        @JavascriptInterface
        public void playIsaflix(
                String name,
                String url,
                String headersJson,
                String queueJson,
                int selectedIndex) {

            runOnUiThread(() -> {
                int targetIndex = selectedIndex;

                if (url == null ||
                        !url.matches("(?i)^https?://.*")) {
                    return;
                }

                try {
                    org.json.JSONArray queue = new org.json.JSONArray(
                            queueJson == null ? "[]" : queueJson
                    );

                    if (queue.length() == 0) {
                        org.json.JSONObject one = new org.json.JSONObject();
                        one.put("name", name == null ? "İSAFLIX" : name);
                        one.put("url", url);
                        one.put("headers", new org.json.JSONObject(
                                headersJson == null ? "{}" : headersJson
                        ));
                        one.put("is_live", false);
                        queue.put(one);
                        targetIndex = 0;
                    }


