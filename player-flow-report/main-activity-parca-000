        @JavascriptInterface
        public void play(
                String name,
                String url,
                String headersJson,
                String queueJson,
                int selectedIndex) {

            runOnUiThread(() -> {
                if (url == null ||
                        !url.matches("(?i)^https?://.*")) {
                    return;
                }

                Intent intent = new Intent(
                        MainActivity.this,
                        PlayerActivity.class
                );

                intent.putExtra("stream_url", url);
                intent.putExtra(
                        "channel_name",
                        name == null ? "İSA TV HD" : name
                );
                intent.putExtra(
                        "headers_json",
                        headersJson == null ? "{}" : headersJson
                );
