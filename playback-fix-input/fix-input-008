        ok: false,
        error: "Invalid redirect address"
      }, 502);
    }
  }

  if (!upstream || (upstream.status >= 300 && upstream.status < 400)) {
    return respondJson({
      ok: false,
      error: "Upstream redirect failed"
    }, 502);
  }

  if (!upstream.ok && upstream.status !== 206) {
