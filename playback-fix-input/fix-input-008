    if (sourceText.length > 2 * 1024 * 1024) {
      return respondJson({ ok: false, error: "Manifest too large" }, 502);
    }

    let rewritten;

    try {
      rewritten = await rewriteManifest(
        sourceText,
        currentUrl,
        env,
        {
